<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- FUT Market Desk momentum discovery scan. Placeholders filled by
     install_autonomous.sh. Runs every __SCAN_INTERVAL_SEC__ seconds. It needs no
     pmset wake of its own — the collector agent already wakes the Mac every few
     minutes, so this fires on one of those wakes when its timer is due. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.futmarket.scan</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/scan_momentum.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StartInterval</key>
  <integer>__SCAN_INTERVAL_SEC__</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__REPO__/data/scan.out</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/scan.err</string>
</dict>
</plist>
