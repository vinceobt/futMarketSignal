# Copy to .env (gitignored) and fill in what you need.
#
# Reddit — reddit.com/prefs/apps -> "create another app" -> type: script
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
#
# YouTube — console.cloud.google.com -> enable "YouTube Data API v3" -> API key
YOUTUBE_API_KEY=
#
# X/Twitter — path to saved login cookies for a BURNER account, never your real one
X_SESSION_FILE=.x_session.json
#
# Discord — an incoming-webhook URL for run summaries. Secrets never go in
# config.yaml, which is committed.
DISCORD_WEBHOOK_URL=
#
# Message extraction. Gemini is the free lane (add GOOGLE_API_KEY_2, _3, ... to
# pool separate quotas); OpenRouter is the paid lane with no daily cap.
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Any model slug from openrouter.ai/models — a fast, cheap one is plenty for
# bulk extraction. Comma-separate to rotate several.
OPENROUTER_MODEL=
