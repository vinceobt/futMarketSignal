# Copy to .env (gitignored) and fill in. Every one of these is FREE.
#
# Reddit — reddit.com/prefs/apps -> "create another app" -> type: script
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
#
# YouTube — console.cloud.google.com -> enable "YouTube Data API v3" -> API key
YOUTUBE_API_KEY=
#
# X/Twitter — path to saved login cookies for the BURNER account, never your real one
X_SESSION_FILE=.x_session.json
#
# Discord alerts (move this out of config.yaml, which is committed)
DISCORD_WEBHOOK_URL=
